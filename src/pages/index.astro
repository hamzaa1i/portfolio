---
import Layout from '../layouts/Layout.astro';
import { SITE } from '../lib/site';
---

<Layout title="Home">
  <div class="container-site py-24">
    <p class="font-mono text-xs text-accent tracking-widest uppercase">{SITE.author} · {SITE.role}</p>
    <h1 class="mt-4 text-4xl font-semibold tracking-tight text-text-primary">
      Software that real businesses run on.
    </h1>
    <p class="mt-6 max-w-xl text-text-secondary">{SITE.description}</p>
  </div>
</Layout>
