---
import Layout from '../layouts/Layout.astro';
import SectionHeading from '../components/SectionHeading.astro';
import ProjectCard from '../components/ProjectCard.astro';
import NotesCard from '../components/NotesCard.astro';
import { SITE, IDENTITY } from '../lib/site';
import { getFeaturedProjects, getFeaturedNotes } from '../lib/content';

const projects = await getFeaturedProjects();
const notes = await getFeaturedNotes();
const [featured, ...rest] = projects;

const capabilities = [
  {
    title: 'Product & Web Platforms',
    body: 'Marketing sites, portals, dashboards and operational web applications built as coherent systems.',
    tech: 'Astro · TypeScript · Supabase · Vercel',
  },
  {
    title: 'ERP & Operations',
    body: 'Internal systems that model real factory workflows, stock movement, traceability and order progress.',
    tech: 'ERPNext · Frappe · Python · PostgreSQL',
  },
  {
    title: 'AI & Automation',
    body: 'AI-assisted workflows, integrations, provider routing, document analysis and operational automation where they provide practical value.',
    tech: 'Provider routing · Vision analysis · Zod',
  },
  {
    title: 'Ecommerce & Digital Experience',
    body: 'Production storefronts, catalogue architecture, responsive product experience and commerce implementation.',
    tech: 'Shopify · Catalogue design · Responsive',
  },
];
---

<Layout title="Home">
  <!-- ============ HERO ============ -->
  <section class="border-b border-border">
    <div class="container-site pt-16 pb-14 sm:pt-24 sm:pb-20">
      <p class="font-mono text-[0.7rem] uppercase tracking-[0.22em] text-accent">
        {SITE.author} · {SITE.role}
      </p>
      <h1
        class="mt-5 max-w-3xl font-display text-[3rem] font-normal leading-[1.05] tracking-[-0.01em] text-text-primary sm:text-6xl lg:text-[4.5rem]"
      >
        Software that real businesses run on.
      </h1>
      <p class="mt-6 max-w-xl text-base leading-relaxed text-text-secondary sm:text-lg">
        I design and build web platforms, manufacturing systems, and production storefronts, from
        internal ERP workflows to client-facing products.
      </p>
      <p class="mt-5 font-mono text-xs text-text-muted">
        {SITE.location} · {SITE.availability}
      </p>

      <div class="mt-9 flex flex-wrap items-center gap-4">
        <a
          href="/work"
          class="inline-flex min-h-11 items-center gap-2 rounded-card border border-accent-dim bg-accent/10 px-5 py-2.5 text-sm font-medium text-accent-hover transition-colors duration-200 hover:border-accent hover:bg-accent/15"
        >
          View selected work
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
        <a
          href="/about"
          class="inline-flex min-h-11 items-center rounded-card border border-border px-5 py-2.5 text-sm font-medium text-text-secondary transition-colors duration-200 hover:border-border-strong hover:text-text-primary"
        >
          About me
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SELECTED WORK ============ -->
  <section class="container-site py-16 sm:py-24" aria-labelledby="work-heading">
    <div class="reveal">
      <SectionHeading id="work-heading" eyebrow="01 · Selected Work" title="Four systems in production" />
      <p class="mt-4 max-w-xl text-text-secondary">
        Case studies built on real evidence: live systems, verified architecture, and workflows in
        daily use.
      </p>
    </div>

    <div class="reveal mt-10">
      {featured && <ProjectCard project={featured} featured />}
    </div>

    <div class="reveal mt-6 grid gap-6 md:grid-cols-2">
      {rest.map((project) => <ProjectCard project={project} />)}
    </div>

    <div class="reveal mt-8">
      <a
        href="/work"
        class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-text-secondary transition-colors hover:text-accent-hover"
      >
        All case studies
        <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </a>
    </div>
  </section>

  <!-- ============ CAPABILITIES ============ -->
  <section class="border-y border-border bg-midnight" aria-labelledby="capabilities-heading">
    <div class="container-site py-16 sm:py-24">
      <div class="reveal">
        <SectionHeading id="capabilities-heading" eyebrow="02 · Capabilities" title="What I build" />
      </div>
      <div class="reveal mt-10 grid gap-px overflow-hidden rounded-card border border-border bg-border sm:grid-cols-2">
        {
          capabilities.map((cap) => (
            <div class="bg-midnight p-6 sm:p-8">
              <h3 class="text-base font-semibold tracking-tight text-text-primary">{cap.title}</h3>
              <p class="mt-3 text-sm leading-relaxed text-text-secondary">{cap.body}</p>
              <p class="mt-4 font-mono text-[0.68rem] text-text-muted">{cap.tech}</p>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  <!-- ============ ABOUT TEASER ============ -->
  <section class="container-site py-16 sm:py-24" aria-labelledby="about-heading">
    <div class="reveal grid gap-8 lg:grid-cols-[1fr_2fr] lg:gap-16">
      <SectionHeading id="about-heading" eyebrow="03 · About" title="Close to the work" />
      <div>
        <p class="text-base leading-relaxed text-text-secondary sm:text-lg">
          I build software from inside the operations it supports. Working within a garment
          manufacturing business gave me direct exposure to the problems software is supposed to
          solve: quote intake, stock movement, order tracking, and production visibility.
        </p>
        <p class="mt-4 text-base leading-relaxed text-text-secondary sm:text-lg">
          That shaped how I build. I prefer systems that survive real workflows over prototypes
          designed only to look impressive.
        </p>
        <a
          href="/about"
          class="mt-6 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-text-secondary transition-colors hover:text-accent-hover"
        >
          More about me
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ SELECTED NOTES ============ -->
  <section class="border-t border-border bg-midnight" aria-labelledby="notes-heading">
    <div class="container-site py-16 sm:py-24">
      <div class="reveal">
        <SectionHeading id="notes-heading" eyebrow="04 · Notes" title="Occasional writing" />
      </div>
      <div class="reveal mt-10 grid gap-6 md:grid-cols-2">
        {notes.map((note) => <NotesCard note={note} />)}
      </div>
      <div class="reveal mt-8">
        <a
          href="/notes"
          class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-text-secondary transition-colors hover:text-accent-hover"
        >
          All notes
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
            <path d="M5 12h14" />
            <path d="m12 5 7 7-7 7" />
          </svg>
        </a>
      </div>
    </div>
  </section>

  <!-- ============ CONTACT BAND ============ -->
  <section class="border-t border-border" aria-labelledby="contact-heading">
    <div class="container-site py-16 sm:py-24">
      <div class="reveal">
        <SectionHeading id="contact-heading" eyebrow="05 · Contact" title="Start a conversation" />
        <p class="mt-4 max-w-xl text-text-secondary">
          The fastest way to reach me is email. I read everything and reply to serious enquiries
          within a few days.
        </p>
        <div class="mt-6 flex flex-wrap gap-4">
          <a
            href={`mailto:${IDENTITY.email}`}
            class="inline-flex min-h-11 items-center gap-2 rounded-card border border-accent-dim bg-accent/10 px-5 py-2.5 text-sm font-medium text-accent-hover transition-colors duration-200 hover:border-accent hover:bg-accent/15"
          >
            {IDENTITY.email}
          </a>
          <a
            href="/contact"
            class="inline-flex min-h-11 items-center rounded-card border border-border px-5 py-2.5 text-sm font-medium text-text-secondary transition-colors duration-200 hover:border-border-strong hover:text-text-primary"
          >
            Contact form
          </a>
        </div>
      </div>
    </div>
  </section>
</Layout>
