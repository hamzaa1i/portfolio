---
import { publicContactEmail } from '../config/contact';
import resume from '../data/resume.json';
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
---
<Layout title="Résumé — Hamza Ali" description="Hamza Ali’s résumé: software and systems engineering, project contributions, education and technical skills. Read online or download the PDF.">
  <Header />
  <div class="min-h-screen px-6" style="padding-top: calc(var(--header-height) + var(--header-margin) * 2 + 3rem);">
    <article class="max-w-2xl mx-auto resume-content" id="resume-content">
      <header class="mb-10">
        <a href="/" class="inline-flex items-center gap-1.5 text-text-dim font-mono text-xs hover:text-accent-primary transition-colors mb-6">← back to home</a>
        <h1 class="text-heading-1 font-heading font-bold text-text-primary">{resume.name}</h1>
        <p class="text-body text-text-secondary mt-1">{resume.title} · {resume.secondaryTitle}</p>
        <div class="flex flex-wrap gap-x-4 gap-y-2 font-mono text-xs text-text-secondary mt-4">
          <span>{resume.location}</span>
          <a href={`mailto:${publicContactEmail}`}>{publicContactEmail}</a>
          <a href={resume.github} target="_blank" rel="noopener noreferrer">github.com/hamzaa1i</a>
          <a href={resume.website}>hamzaalikhurram.com</a>
        </div>
        <div class="flex flex-wrap gap-3 mt-6 resume-actions">
          <a href="/Hamza_Ali_Resume.pdf" download="Hamza_Ali_Resume.pdf" class="btn-secondary btn-sm" aria-label="Download Hamza Ali’s résumé as PDF">Download PDF ↓</a>
        </div>
      </header>
      <section class="mb-8" id="resume-summary" aria-labelledby="summary-heading">
        <h2 id="summary-heading" class="resume-heading">Summary</h2>
        <p class="text-body-sm text-text-secondary leading-relaxed">{resume.summary}</p>
      </section>
      <section class="mb-8" aria-labelledby="experience-heading">
        <h2 id="experience-heading" class="resume-heading">Relevant Experience</h2>
        {resume.experience.map(item => (
          <div>
            <h3 class="font-heading text-sm font-semibold text-text-primary">{item.heading}</h3>
            <p class="font-mono text-xs text-text-secondary mt-1">{item.period}</p>
            <p class="text-xs text-text-muted mt-2">{item.scope}</p>
            <ul class="resume-bullets text-body-sm text-text-secondary mt-3">{item.bullets.map(point => <li>{point}</li>)}</ul>
          </div>
        ))}
      </section>
      <section class="mb-8" aria-labelledby="projects-heading">
        <h2 id="projects-heading" class="resume-heading">Selected Projects</h2>
        <div class="space-y-5">{resume.projects.map(project => (
          <div>
            <h3 class="font-heading text-sm font-semibold text-text-primary"><a href={project.href}>{project.name} ↗</a></h3>
            <p class="font-mono text-xs text-text-secondary mt-1">{project.scope}</p>
            <p class="text-body-sm text-text-secondary mt-2 leading-relaxed">{project.description}</p>
          </div>
        ))}</div>
      </section>
      <section class="mb-8" aria-labelledby="education-heading">
        <h2 id="education-heading" class="resume-heading">Education</h2>
        <div class="space-y-4">{resume.education.map(item => (
          <div>
            <h3 class="font-heading text-sm font-semibold text-text-primary">{item.heading}</h3>
            <p class="text-body-sm text-text-secondary mt-1">{item.institution}{item.period && ` · ${item.period}`}</p>
            {item.detail && <p class="text-body-sm text-text-secondary">{item.detail}</p>}
          </div>
        ))}</div>
      </section>
      <section class="mb-10" aria-labelledby="skills-heading">
        <h2 id="skills-heading" class="resume-heading">Technical Skills</h2>
        <div class="space-y-3">{resume.skills.map(group => (
          <p class="text-body-sm text-text-secondary"><strong class="text-text-primary">{group.group}: </strong>{group.items.join(', ')}</p>
        ))}</div>
      </section>
      <div class="glass p-5 mb-10 flex flex-wrap items-center justify-between gap-4 resume-actions">
        <a href="/work" class="btn-secondary btn-sm">View all projects →</a>
        <a href="/#contact" class="btn-primary btn-sm">get in touch ↗</a>
      </div>
    </article>
  </div>
  <div class="py-10"></div>
  <Footer />
</Layout>
<style>
  .resume-heading { font-family: 'JetBrains Mono', ui-monospace, monospace; font-size: 0.85rem; font-weight: 600; color: var(--accent); text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 1rem; }
  .resume-content a:not(.btn-primary):not(.btn-secondary) { text-decoration: underline; text-underline-offset: 3px; }
  .resume-content { overflow-wrap: anywhere; }
  .resume-bullets { list-style: disc; padding-left: 1.1rem; }
  .resume-bullets li + li { margin-top: 0.5rem; }
  @media print {
    .resume-actions { display: none; }
    .resume-content { color: black; }
  }
</style>
