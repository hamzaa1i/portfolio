---
import type { Note } from '../lib/content';

interface Props {
  note: Note;
}

const { note } = Astro.props;
const { data } = note;
const href = `/notes/${note.id}`;
const date = data.pubDate.toLocaleDateString('en-GB', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<article class="group rounded-card border border-border bg-surface transition-colors duration-200 hover:border-border-strong">
  <a href={href} class="block p-5 sm:p-6 focus-visible:outline-offset-4">
    <div class="flex items-baseline justify-between gap-4">
      <p class="font-mono text-[0.65rem] text-text-muted">{date}</p>
      {
        data.tags.length > 0 && (
          <p class="font-mono text-[0.65rem] uppercase tracking-[0.14em] text-text-muted">
            {data.tags[0]}
          </p>
        )
      }
    </div>
    <h3 class="mt-2 text-lg font-semibold leading-snug tracking-tight text-text-primary transition-colors group-hover:text-accent-hover">
      {data.title}
    </h3>
    <p class="mt-2 text-sm text-text-secondary">{data.description}</p>
    <div class="mt-4 flex items-center gap-2 text-sm font-medium text-text-primary">
      <span class="transition-colors group-hover:text-accent-hover">Read note</span>
      <svg
        width="14"
        height="14"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
        class="transition-transform duration-200 group-hover:translate-x-0.5"
        aria-hidden="true"
      >
        <path d="M5 12h14" />
        <path d="m12 5 7 7-7 7" />
      </svg>
    </div>
  </a>
</article>
