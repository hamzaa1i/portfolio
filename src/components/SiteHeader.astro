---
import { NAV, SITE } from '../lib/site';

const { pathname } = Astro.url;

const isCurrent = (href: string) =>
  href === '/' ? pathname === '/' : pathname === href || pathname.startsWith(`${href}/`);
---

<header
  id="site-header"
  class="fixed inset-x-0 top-0 z-40 border-b border-border bg-void/85 backdrop-blur-md"
>
  <div class="container-site flex h-16 items-center justify-between gap-6">
    <a
      href="/"
      class="text-[0.95rem] font-semibold tracking-tight text-text-primary transition-colors hover:text-accent-hover"
      aria-label={`${SITE.author} — home`}
    >
      Hamza Ali
    </a>

    <nav class="hidden md:block" aria-label="Main navigation">
      <ul class="flex items-center gap-7">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'text-sm transition-colors',
                  isCurrent(item.href)
                    ? 'text-text-primary font-medium'
                    : 'text-text-secondary hover:text-text-primary',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <button
      type="button"
      id="menu-toggle"
      class="flex h-11 w-11 items-center justify-center text-text-secondary transition-colors hover:text-text-primary md:hidden"
      aria-expanded="false"
      aria-controls="mobile-menu"
      aria-label="Open menu"
    >
      <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" aria-hidden="true">
        <line x1="4" y1="7" x2="20" y2="7" />
        <line x1="4" y1="12" x2="20" y2="12" />
        <line x1="4" y1="17" x2="20" y2="17" />
      </svg>
    </button>
  </div>

  <div
    id="mobile-menu"
    class="border-t border-border bg-void md:hidden"
    hidden
  >
    <nav aria-label="Mobile navigation" class="container-site py-4">
      <ul class="grid gap-1">
        {
          NAV.map((item) => (
            <li>
              <a
                href={item.href}
                aria-current={isCurrent(item.href) ? 'page' : undefined}
                class:list={[
                  'flex min-h-11 items-center rounded-card px-3 text-[0.95rem] transition-colors',
                  isCurrent(item.href)
                    ? 'bg-surface text-text-primary font-medium'
                    : 'text-text-secondary hover:bg-midnight hover:text-text-primary',
                ]}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>
  </div>
</header>

<script>
  const header = document.getElementById('site-header');
  const toggle = document.getElementById('menu-toggle');
  const menu = document.getElementById('mobile-menu');

  if (header && toggle && menu) {
    const isOpen = () => !menu!.hidden;

    const setOpen = (open: boolean) => {
      menu!.hidden = !open;
      toggle!.setAttribute('aria-expanded', String(open));
      toggle!.setAttribute('aria-label', open ? 'Close menu' : 'Open menu');
      document.body.style.overflow = open ? 'hidden' : '';
    };

    toggle.addEventListener('click', () => {
      setOpen(isOpen() ? false : true);
    });

    menu.addEventListener('click', (event) => {
      if (event.target instanceof HTMLAnchorElement) {
        setOpen(false);
      }
    });

    document.addEventListener('keydown', (event) => {
      if (event.key === 'Escape' && isOpen()) {
        setOpen(false);
        toggle!.focus();
      }
    });

    // Close if focus leaves the header entirely (e.g. tab into page).
    header.addEventListener('focusout', (event) => {
      if (isOpen() && !header!.contains(event.relatedTarget as Node)) {
        setOpen(false);
      }
    });

    // Close on viewport growth to desktop.
    const mq = window.matchMedia('(min-width: 768px)');
    const onChange = () => {
      if (mq.matches && isOpen()) setOpen(false);
    };
    mq.addEventListener('change', onChange);
  }
</script>
