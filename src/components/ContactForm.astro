---
import { getContactConfig } from '../lib/contact';

const { turnstileSiteKey } = getContactConfig();
---

<form
  id="contact-form"
  class="mt-6 grid gap-5"
  novalidate
  data-turnstile-site-key={turnstileSiteKey || undefined}
>
  <!-- Honeypot: hidden from users, irresistible to bots -->
  <div class="hidden" aria-hidden="true">
    <label for="company_website">Company website</label>
    <input
      type="text"
      id="company_website"
      name="company_website"
      tabindex="-1"
      autocomplete="off"
    />
  </div>

  <div class="grid gap-5 sm:grid-cols-2">
    <div>
      <label for="contact-name" class="block text-sm font-medium text-text-primary">
        Name <span class="text-accent" aria-hidden="true">*</span>
      </label>
      <input
        type="text"
        id="contact-name"
        name="name"
        required
        autocomplete="name"
        maxlength="100"
        class="mt-2 min-h-11 w-full rounded-card border border-border bg-midnight px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-muted transition-colors focus:border-accent-dim"
        placeholder="Your name"
      />
      <p class="mt-1.5 hidden text-xs text-red-400" data-error-for="name"></p>
    </div>

    <div>
      <label for="contact-email" class="block text-sm font-medium text-text-primary">
        Email <span class="text-accent" aria-hidden="true">*</span>
      </label>
      <input
        type="email"
        id="contact-email"
        name="email"
        required
        autocomplete="email"
        maxlength="254"
        class="mt-2 min-h-11 w-full rounded-card border border-border bg-midnight px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-muted transition-colors focus:border-accent-dim"
        placeholder="you@example.com"
      />
      <p class="mt-1.5 hidden text-xs text-red-400" data-error-for="email"></p>
    </div>
  </div>

  <div>
    <label for="contact-subject" class="block text-sm font-medium text-text-primary">
      Project / subject <span class="text-accent" aria-hidden="true">*</span>
    </label>
    <input
      type="text"
      id="contact-subject"
      name="subject"
      required
      maxlength="150"
      class="mt-2 min-h-11 w-full rounded-card border border-border bg-midnight px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-muted transition-colors focus:border-accent-dim"
      placeholder="What is this about?"
    />
    <p class="mt-1.5 hidden text-xs text-red-400" data-error-for="subject"></p>
  </div>

  <div>
    <label for="contact-message" class="block text-sm font-medium text-text-primary">
      Message <span class="text-accent" aria-hidden="true">*</span>
    </label>
    <textarea
      id="contact-message"
      name="message"
      required
      rows="6"
      maxlength="5000"
      class="mt-2 w-full rounded-card border border-border bg-midnight px-3.5 py-2.5 text-sm text-text-primary placeholder:text-text-muted transition-colors focus:border-accent-dim"
      placeholder="What are you building, what state is it in, and what do you need?"
    ></textarea>
    <p class="mt-1.5 hidden text-xs text-red-400" data-error-for="message"></p>
  </div>

  {
    turnstileSiteKey && (
      <div class="cf-turnstile" data-sitekey={turnstileSiteKey} data-theme="dark" />
    )
  }

  <div
    id="contact-status"
    class="hidden rounded-card border border-border bg-midnight px-4 py-3 text-sm"
    role="status"
    aria-live="polite"
  ></div>

  <div>
    <button
      type="submit"
      class="inline-flex min-h-11 items-center gap-2 rounded-card border border-accent-dim bg-accent/10 px-5 py-2.5 text-sm font-medium text-accent-hover transition-colors duration-200 hover:border-accent hover:bg-accent/15 disabled:cursor-not-allowed disabled:opacity-60"
    >
      Send message
    </button>
    <p class="mt-3 text-xs text-text-muted">
      Delivered by first-party email. Prefer email directly? The address is on the left.
    </p>
  </div>
</form>

<script>
  import { contactSchema } from '../lib/contact-schema';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('contact-status');
  const submitButton = form?.querySelector('button[type="submit"]') as HTMLButtonElement | null;

  const setError = (field: string, message: string) => {
    const el = form?.querySelector(`[data-error-for="${field}"]`);
    if (el) {
      el.textContent = message;
      el.classList.remove('hidden');
    }
  };

  const clearErrors = () => {
    form?.querySelectorAll('[data-error-for]').forEach((el) => {
      el.textContent = '';
      el.classList.add('hidden');
    });
  };

  const showStatus = (text: string, kind: 'ok' | 'error') => {
    if (!status) return;
    status.textContent = text;
    status.classList.remove('hidden');
    status.classList.toggle('text-success', kind === 'ok');
    status.classList.toggle('border-red-900', kind === 'error');
    status.classList.toggle('text-red-400', kind === 'error');
  };

  if (form && status && submitButton) {
    // Load Turnstile only when the server provided a site key.
    const siteKey = form.dataset.turnstileSiteKey;
    if (siteKey && !document.querySelector('script[data-turnstile]')) {
      const script = document.createElement('script');
      script.src = 'https://challenges.cloudflare.com/turnstile/v0/api.js';
      script.async = true;
      script.defer = true;
      script.dataset.turnstile = 'true';
      document.head.appendChild(script);
    }

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      clearErrors();
      status.classList.add('hidden');

      const data = Object.fromEntries(new FormData(form).entries());
      const parsed = contactSchema.safeParse(data);

      if (!parsed.success) {
        let firstField: string | null = null;
        for (const issue of parsed.error.issues) {
          const field = String(issue.path[0] ?? '');
          if (field) {
            setError(field, issue.message);
            if (!firstField) firstField = field;
          }
        }
        if (firstField) {
          form.querySelector<HTMLElement>(`[name="${firstField}"]`)?.focus();
        }
        return;
      }

      submitButton.disabled = true;
      submitButton.textContent = 'Sending…';

      try {
        const res = await fetch('/api/contact', {
          method: 'POST',
          headers: { 'content-type': 'application/json' },
          body: JSON.stringify(data),
        });
        const body = (await res.json().catch(() => ({}))) as {
          ok?: boolean;
          message?: string;
          issues?: Array<{ field: string; message: string }>;
        };

        if (res.ok && body.ok) {
          form.reset();
          showStatus(
            'Message sent. Thank you. I will reply by email within a few days.',
            'ok',
          );
        } else if (body.issues) {
          for (const issue of body.issues) setError(issue.field, issue.message);
          showStatus('Please fix the highlighted fields and try again.', 'error');
        } else if (res.status === 503) {
          showStatus(
            'Email delivery is not configured on this deployment. Please use the direct email link on this page.',
            'error',
          );
        } else {
          showStatus(
            'Something went wrong sending the message. Please use the direct email link on this page.',
            'error',
          );
        }
      } catch {
        showStatus(
          'The network request failed. Please use the direct email link on this page.',
          'error',
        );
      } finally {
        submitButton.disabled = false;
        submitButton.textContent = 'Send message';
      }
    });
  }
</script>
