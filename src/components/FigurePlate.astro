---
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  /** Zero-padded figure number, e.g. "01". */
  number: string;
  image: ImageMetadata;
  /** Describes the product state shown, not "a screenshot". */
  alt: string;
  /** Short, restrained caption. */
  caption: string;
  /** Optional technical metadata, e.g. "1440 × 900 · September 2026". */
  context?: string;
  /** Render eager for above-fold plates. */
  eager?: boolean;
  /** Optional layout width class. */
  class?: string;
}

const { number, image, alt, caption, context, eager = false, class: className } = Astro.props;
---

<figure class:list={['border border-border bg-midnight rounded-image', className]}>
  <div class="overflow-hidden rounded-t-image border-b border-border">
    <Picture
      src={image}
      alt={alt}
      widths={[720, 1024, 1440, 1920]}
      sizes="(min-width: 1200px) 1088px, (min-width: 768px) 90vw, 100vw"
      formats={['avif', 'webp']}
      loading={eager ? 'eager' : 'lazy'}
      class="block w-full h-auto"
    />
  </div>
  <figcaption class="flex flex-col gap-1 px-4 py-3 sm:flex-row sm:items-baseline sm:justify-between sm:gap-6">
    <p class="text-sm text-text-secondary">
      <span class="font-mono text-[0.65rem] font-medium uppercase tracking-[0.18em] text-accent">
        Figure {number}
      </span>
      <span class="mx-2 text-border-strong" aria-hidden="true">/</span>{caption}
    </p>
    {
      context && (
        <p class="font-mono text-[0.65rem] text-text-muted whitespace-nowrap">{context}</p>
      )
    }
  </figcaption>
</figure>
