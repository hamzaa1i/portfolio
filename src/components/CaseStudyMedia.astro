---
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  caption: string;
  label?: string;
}

const { image, alt, caption, label = 'verified project capture' } = Astro.props;
---

<figure class="case-media glass" data-animate="fade-up">
  <button
    type="button"
    class="case-media-frame"
    data-lightbox={image.src}
    data-lightbox-alt={alt}
    aria-label={`Open larger image: ${alt}`}
  >
    <img
      src={image.src}
      width={image.width}
      height={image.height}
      alt={alt}
      loading="lazy"
      decoding="async"
    />
    <span class="case-media-label">{label}</span>
  </button>
  <figcaption>{caption}</figcaption>
</figure>

<style>
  .case-media {
    margin: 2rem 0;
    padding: 0.65rem;
    overflow: hidden;
  }

  .case-media-frame {
    display: block;
    width: 100%;
    padding: 0;
    position: relative;
    overflow: hidden;
    border: 0;
    border-radius: 0.6rem;
    background: var(--midnight);
    text-align: left;
  }

  .case-media-frame::after {
    content: '';
    position: absolute;
    inset: 0;
    border: 1px solid rgba(255, 255, 255, 0.07);
    border-radius: inherit;
    pointer-events: none;
  }

  .case-media img {
    display: block;
    width: 100%;
    height: auto;
    transition: transform 0.7s var(--ease-out-expo);
  }

  .case-media-frame:hover img {
    transform: scale(1.015);
  }

  .case-media-label {
    position: absolute;
    left: 0.75rem;
    bottom: 0.75rem;
    padding: 0.35rem 0.55rem;
    border: 1px solid rgba(255, 255, 255, 0.1);
    border-radius: 999px;
    background: rgba(9, 9, 11, 0.86);
    color: #d4d4d8;
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.5rem;
    letter-spacing: 0.08em;
    line-height: 1;
    text-transform: uppercase;
    backdrop-filter: blur(8px);
  }

  figcaption {
    padding: 0.75rem 0.25rem 0.2rem;
    color: var(--text-muted);
    font-family: 'JetBrains Mono', monospace;
    font-size: 0.65rem;
    line-height: 1.6;
  }

  @media (prefers-reduced-motion: reduce) {
    .case-media img { transition: none; }
  }
</style>
