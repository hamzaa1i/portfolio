---
import { IDENTITY, NAV, SITE } from '../lib/site';

const year = new Date().getFullYear();
---

<footer class="border-t border-border bg-midnight">
  <div class="container-site py-12 md:py-14">
    <div class="flex flex-col gap-10 md:flex-row md:items-start md:justify-between">
      <div class="max-w-sm">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-text-muted">
          {SITE.author} · {SITE.role}
        </p>
        <p class="mt-3 text-sm text-text-secondary">
          {SITE.location}. {SITE.availability}.
        </p>
        <a
          href={`mailto:${IDENTITY.email}`}
          class="mt-4 inline-block font-mono text-sm text-accent-hover transition-colors hover:text-accent"
        >
          {IDENTITY.email}
        </a>
      </div>

      <nav aria-label="Footer navigation">
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-text-muted">Index</p>
        <ul class="mt-3 grid gap-2">
          {
            NAV.map((item) => (
              <li>
                <a
                  href={item.href}
                  class="text-sm text-text-secondary transition-colors hover:text-text-primary"
                >
                  {item.label}
                </a>
              </li>
            ))
          }
        </ul>
      </nav>

      <div>
        <p class="font-mono text-[0.7rem] uppercase tracking-[0.18em] text-text-muted">Elsewhere</p>
        <ul class="mt-3 grid gap-2">
          <li>
            <a
              href={IDENTITY.github}
              target="_blank"
              rel="noopener noreferrer"
              class="text-sm text-text-secondary transition-colors hover:text-text-primary"
            >
              GitHub
            </a>
          </li>
          {
            IDENTITY.linkedin && (
              <li>
                <a
                  href={IDENTITY.linkedin}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="text-sm text-text-secondary transition-colors hover:text-text-primary"
                >
                  LinkedIn
                </a>
              </li>
            )
          }
        </ul>
      </div>
    </div>

    <div class="mt-10 flex flex-col gap-2 border-t border-border pt-6 sm:flex-row sm:items-center sm:justify-between">
      <p class="font-mono text-xs text-text-muted">
        © {year} {SITE.author}
      </p>
      <p class="font-mono text-xs text-text-muted">
        Designed and built by hand. Astro, TypeScript, Tailwind.
      </p>
    </div>
  </div>
</footer>
