---
import { Picture } from 'astro:assets';
import type { Project } from '../lib/content';

interface Props {
  project: Project;
  /** Featured treatment for the lead project. */
  featured?: boolean;
}

const { project, featured = false } = Astro.props;
const { data } = project;
const href = `/work/${project.id}`;
---

<article
  class:list={[
    'group relative rounded-card border bg-surface transition-colors duration-200 hover:border-border-strong',
    featured ? 'overflow-hidden' : 'overflow-hidden',
  ]}
>
  <a href={href} class="block focus-visible:outline-offset-4" aria-label={`Case study: ${data.title}`}>
    {
      data.thumbnail ? (
        <div class="overflow-hidden border-b border-border">
          <Picture
            src={data.thumbnail}
            alt={`${data.title} — ${data.subtitle}`}
            widths={featured ? [960, 1280, 1920] : [640, 960, 1280]}
            sizes={featured ? '(min-width: 1200px) 1088px, 100vw' : '(min-width: 768px) 50vw, 100vw'}
            formats={['avif', 'webp']}
            loading={featured ? 'eager' : 'lazy'}
            class="block aspect-[16/10] w-full h-auto object-cover object-top transition-transform duration-300 ease-out group-hover:scale-[1.01]"
          />
        </div>
      ) : (
        <div class="flex aspect-[16/10] items-center justify-center border-b border-border bg-midnight">
          <span class="font-mono text-[0.65rem] uppercase tracking-[0.2em] text-text-muted">
            {data.category}
          </span>
        </div>
      )
    }

    <div class="p-5 sm:p-6">
      <div class="flex items-baseline justify-between gap-4">
        <p class="font-mono text-[0.65rem] uppercase tracking-[0.18em] text-accent">
          {data.category}
        </p>
        {
          data.timeline && (
            <p class="font-mono text-[0.65rem] text-text-muted whitespace-nowrap">{data.timeline}</p>
          )
        }
      </div>

      <h3
        class:list={[
          'mt-2 font-semibold tracking-tight text-text-primary',
          featured ? 'text-xl sm:text-2xl' : 'text-lg',
        ]}
      >
        {data.shortTitle}
      </h3>
      <p class="mt-1.5 text-sm text-text-secondary">{data.subtitle}</p>

      <div class="mt-4 flex flex-wrap gap-x-3 gap-y-1.5">
        {
          data.stack.slice(0, 5).map((tech) => (
            <span class="font-mono text-[0.68rem] text-text-muted">{tech}</span>
          ))
        }
      </div>

      <div class="mt-5 flex items-center gap-2 text-sm font-medium text-text-primary">
        <span class="transition-colors group-hover:text-accent-hover">Read case study</span>
        <svg
          width="14"
          height="14"
          viewBox="0 0 24 24"
          fill="none"
          stroke="currentColor"
          stroke-width="2"
          stroke-linecap="round"
          stroke-linejoin="round"
          class="translate-x-0 transition-transform duration-200 group-hover:translate-x-0.5"
          aria-hidden="true"
        >
          <path d="M5 12h14" />
          <path d="m12 5 7 7-7 7" />
        </svg>
      </div>
    </div>
  </a>

  {
    data.liveUrl && (
      <a
        href={data.liveUrl}
        target="_blank"
        rel="noopener noreferrer"
        class="absolute right-4 top-4 inline-flex items-center gap-1.5 rounded-full border border-border bg-void/80 px-3 py-1.5 font-mono text-[0.65rem] text-text-secondary backdrop-blur transition-colors hover:text-accent-hover hover:border-accent-dim"
        aria-label={`Visit live site: ${data.title}`}
      >
        Live site
        <svg width="10" height="10" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="M7 17 17 7" />
          <path d="M7 7h10v10" />
        </svg>
      </a>
    )
  }
</article>
