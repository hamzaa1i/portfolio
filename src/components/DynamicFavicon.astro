---
// DynamicFavicon.astro — Dynamic favicon that matches theme accent color
---

<script is:inline>
(function () {
  function generateFavicon(accentColor) {
    var svg = '<svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 32 32">' +
      '<defs><style>' +
      '@font-face{font-family:"JB";font-style:normal;font-weight:700;' +
      'src:url("https://fonts.gstatic.com/s/jetbrainsmono/v18/tDbY2o-flEEny0FZhsfKu5WU4zr3E_BX0PnT8RD8yKxjPVmUsaaDhw.woff2") format("woff2");}' +
      '.jb{font-family:"JB","JetBrains Mono",ui-monospace,monospace;font-weight:700;font-size:22px}' +
      '.jbSlash{font-family:"JB","JetBrains Mono",ui-monospace,monospace;font-weight:500;font-size:22px;opacity:.7}' +
      '</style></defs>' +
      '<g>' +
      '<text class="jb" x="1.5" y="24" fill="' + accentColor + '">~</text>' +
      '<text class="jbSlash" x="9.5" y="24" fill="#848484">/</text>' +
      '<text class="jb" x="19.5" y="24" fill="#FAFAFA">h</text>' +
      '</g></svg>';
    return 'data:image/svg+xml,' + encodeURIComponent(svg);
  }

  function updateFavicon() {
    var accentColor = getComputedStyle(document.documentElement)
      .getPropertyValue('--accent').trim() || '#C8A24E';

    var link = document.getElementById('dynamic-favicon');
    if (!link) {
      link = document.createElement('link');
      link.id = 'dynamic-favicon';
      link.rel = 'icon';
      link.type = 'image/svg+xml';
      document.head.appendChild(link);
    }
    link.href = generateFavicon(accentColor);
  }

  // Initial load
  if (document.readyState === 'loading') {
    document.addEventListener('DOMContentLoaded', updateFavicon);
  } else {
    setTimeout(updateFavicon, 0);
  }

  // Update when theme changes
  document.addEventListener('theme:change', function () {
    setTimeout(updateFavicon, 50);
  });
})();
</script>