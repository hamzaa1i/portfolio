---
import SiteHeader from '../components/SiteHeader.astro';
import Footer from '../components/Footer.astro';
import { SITE } from '../lib/site';
import '../styles/global.css';

interface Props {
  /** Page title, without the site suffix. */
  title: string;
  /** Page-specific description. Falls back to the site description. */
  description?: string;
  /** Root-relative canonical path, e.g. "/work/reve-platform". */
  path?: string;
  /** OG image filename inside /og. Defaults by route. */
  ogImage?: string;
}

const { title, description = SITE.description, path = '/', ogImage } = Astro.props;

const canonical = new URL(path, SITE.url).href;
const fullTitle = path === '/' ? `${SITE.title} — ${SITE.role}` : `${title} — ${SITE.title}`;

const defaultOgByPath: Record<string, string> = {
  '/': 'og-default.png',
  '/work': 'og-work.png',
  '/about': 'og-about.png',
  '/notes': 'og-notes.png',
  '/resume': 'og-resume.png',
  '/contact': 'og-contact.png',
};

const projectOgBySlug: Record<string, string> = {
  'reve-platform': 'og-reve-platform.png',
  'haus-couture': 'og-haus-couture.png',
  aurelia: 'og-aurelia.png',
  'reve-erp': 'og-reve-erp.png',
};

let resolvedOg = ogImage ?? defaultOgByPath[path] ?? 'og-default.png';
if (path.startsWith('/work/') && !ogImage) {
  const slug = path.replace('/work/', '').replace(/\/$/, '');
  resolvedOg = projectOgBySlug[slug] ?? 'og-work.png';
}

const ogImageUrl = new URL(`/og/${resolvedOg}`, SITE.url).href;

const personJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: SITE.author,
  url: SITE.url,
  email: 'mailto:hamzaali.dev@proton.me',
  jobTitle: SITE.role,
  address: {
    '@type': 'PostalAddress',
    addressLocality: 'Faisalabad',
    addressCountry: 'PK',
  },
  knowsAbout: [
    'Web platforms',
    'ERP systems',
    'ERPNext',
    'Ecommerce',
    'TypeScript',
    'Python',
  ],
  sameAs: ['https://github.com/hamzaa1i'],
};

const websiteJsonLd = {
  '@context': 'https://schema.org',
  '@type': 'WebSite',
  name: SITE.title,
  url: SITE.url,
  description: SITE.description,
  inLanguage: 'en',
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />

    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    <meta name="author" content={SITE.author} />
    <meta name="theme-color" content="#09090b" />

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={SITE.title} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImageUrl} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${SITE.title} — ${title}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImageUrl} />

    <script is:inline type="application/ld+json" set:html={JSON.stringify(personJsonLd)} />
    <script is:inline type="application/ld+json" set:html={JSON.stringify(websiteJsonLd)} />
    <slot name="head" />

    <script is:inline>
      // Gate reveal animations on JS availability, before first paint.
      document.documentElement.classList.add('js-reveal');
    </script>
  </head>
  <body>
    <a
      href="#main"
      class="sr-only focus:not-sr-only focus:fixed focus:top-4 focus:left-4 focus:z-50 focus:bg-surface focus:text-text-primary focus:px-4 focus:py-2 focus:rounded-card focus:border focus:border-border"
    >
      Skip to content
    </a>

    <SiteHeader />

    <main id="main" class="pt-16">
      <slot />
    </main>

    <Footer />

    <script>
      import '../scripts/reveal';
    </script>

    <script is:inline>
      // The one quiet signature. No phone numbers.
      console.log(
        '%cPortfolio V2%c\nDesigned & built by Hamza Ali\ngithub.com/hamzaa1i/portfolio',
        'color: #c8a24e; font-weight: 600;',
        'color: #a1a1aa;',
      );
    </script>
  </body>
</html>
