# Server-only credentials. Use the existing verified domain and scoped Resend key.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hamzaali.dev@proton.me,hamzaali.work.pk@gmail.com
CONTACT_FROM_EMAIL=Portfolio <contact@hamzaalikhurram.com>
TURNSTILE_SECRET_KEY=
# Public build-time configuration; rebuild after changes.
PUBLIC_TURNSTILE_SITE_KEY=
# Change to hello@hamzaalikhurram.com only after inbound routing is verified.
PUBLIC_CONTACT_EMAIL=hamzaali.dev@proton.me
# Optional exact additional preview hostnames, without scheme/path/wildcards.
# VERCEL_URL and VERCEL_BRANCH_URL are allowed automatically on Vercel.
CONTACT_ALLOWED_HOSTNAMES=
# Local development only, never Preview/Production. Still sends real email.
CONTACT_ALLOW_INSECURE_LOCAL=false
