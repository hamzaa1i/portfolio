# ── Contact endpoint ──────────────────────────────────────────────
# Resend transactional email delivery. Without these the endpoint
# returns a controlled 503 and the direct email link stays usable.
RESEND_API_KEY=
CONTACT_TO_EMAIL=hamzaali.dev@proton.me
# Must be a verified sending domain on the Resend account.
RESEND_FROM_EMAIL=

# ── Cloudflare Turnstile ──────────────────────────────────────────
# Server-side verification of the widget token. Optional: without a
# secret key the form relies on validation + honeypot only.
PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# ── Site ──────────────────────────────────────────────────────────
# Canonical origin. Override only when the domain changes.
# SITE_URL=https://hamzaalidev.vercel.app
